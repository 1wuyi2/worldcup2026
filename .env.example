# Optional Docker Compose settings.
# Copy this file to .env and replace every CHANGE_ME value locally.
# Never commit .env.

MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=worldcup2026
MYSQL_USER=worldcup2026
MYSQL_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

# Only needed if the optional PostgreSQL service is enabled.
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
